{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ghost": {
    "Kernel": {
      "Headless": false,
      "SlowMo": 50,
      "MaxConcurrentSessions": 5
    },
    "Extensions": {
      "LinkedIn": { "Enabled": true },
      "Google": { "Enabled": false },
      "OpenAI": { "Enabled": false },
      "Anthropic": { "Enabled": false }
    }
  }
}
