{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ghost": {
    "Kernel": {
      "Headless": true,
      "SlowMo": 50,
      "MaxConcurrentSessions": 5
    },
    "Extensions": {
      "LinkedIn": {
        "Enabled": true,
        "ScrapingStrategy": "Hybrid",
        "ProxyEnabled": true,
        "WarmUpEnabled": true,
        "StorageStatePath": "linkedin_guest_session.json"
      },
      "Google": { "Enabled": false },
      "OpenAI": { "Enabled": false },
      "Anthropic": { "Enabled": false }
    }
  }
}
