{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ghost": {
    "Kernel": {
      "Headless": true,
      "SlowMo": 50,
      "MaxConcurrentSessions": 5
    },
    "Extensions": {
      "LinkedIn": {
        "Enabled": true,
        "ScrapingStrategy": "Hybrid",
        "ProxyEnabled": true,
        "WarmUpEnabled": true,
        "StorageStatePath": "linkedin_guest_session.json"
      },
      "Google": { "Enabled": false },
      "OpenAI": { "Enabled": false },
      "Anthropic": { "Enabled": false }
    }
    ,
    "Proxy": {
      "Strategy": "RoundRobin",
      "Static": {
        "Enabled": true,
        "Port": 1080,
        "Username": "YOUR_NORD_USERNAME",
        "Password": "YOUR_NORD_PASSWORD",
        "Items": [
          "socks5://nl.socks.nordhold.net",
          "socks5://se.socks.nordhold.net",
          "socks5://us.socks.nordhold.net",
          "socks5://amsterdam.nl.socks.nordhold.net",
          "socks5://atlanta.us.socks.nordhold.net",
          "socks5://chicago.us.socks.nordhold.net",
          "socks5://dallas.us.socks.nordhold.net",
          "socks5://los-angeles.us.socks.nordhold.net",
          "socks5://new-york.us.socks.nordhold.net",
          "socks5://phoenix.us.socks.nordhold.net",
          "socks5://san-francisco.us.socks.nordhold.net",
          "socks5://stockholm.se.socks.nordhold.net"
        ]
      },
      "Api": {
        "Enabled": false,
        "Url": "https://api.proxyscrape.com/v2/?request=getproxies&protocol=http&timeout=5000&country=US&ssl=all&anonymity=all"
      }
    }
  }
}
