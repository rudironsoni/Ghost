<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Ghost.Sdk.Spider</AssemblyName>
    <RootNamespace>Ghost.Sdk.Spider</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591;CA1805;CA1711;CA1310;CA1816;CA1822;CA1852;CA1862;CA1865;IDE0032;CA1016;CA1510;CA1861;IDE0270;IDE0031;CA1305;CA1716;CA1000;CA1826;CA2201</WarningsNotAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>preview</LangVersion>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
  </PropertyGroup>

  <ItemGroup>
    <!-- Browser Automation -->
    <PackageReference Include="Microsoft.Playwright" />
    
    <!-- Configuration -->
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Newtonsoft.Json" />
    
    <!-- JSON Processing -->
    <PackageReference Include="JsonPath.Net" />
    <PackageReference Include="JMESPath.NET" />
    
    <!-- Scheduling -->
    <PackageReference Include="Quartz" />
    <PackageReference Include="Quartz.Extensions.Hosting" />
    
    <!-- Resilience -->
    <PackageReference Include="Polly" />
    <PackageReference Include="Polly.Extensions.Http" />
    
    <!-- HTML Parsing -->
    <PackageReference Include="HtmlAgilityPack" />
    <PackageReference Include="AngleSharp" />
    
    <!-- Validation -->
    <PackageReference Include="FluentValidation" />
    
    <!-- Extensions -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    
    <!-- Storage -->
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Elasticsearch.Net" />
    <PackageReference Include="NEST" />
    
    <!-- Caching/Distributed -->
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Ghost.Sdk.Spider.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
