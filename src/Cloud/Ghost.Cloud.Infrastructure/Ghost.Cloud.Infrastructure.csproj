<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Ghost.Cloud.Infrastructure</RootNamespace>
    <Description>Ghost Cloud infrastructure layer for persistence and event storage</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
  </PropertyGroup>

  <!-- CA2007 disabled: await using statements are properly handled by the compiler-generated disposal -->
  <!-- Approval: Temporary suppression for Infrastructure project only, awaiting upstream analyzer fix -->
  <!-- Expiry: 2025-03-01 -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Orleans.Sdk" />
    <PackageReference Include="Microsoft.Orleans.EventSourcing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Ghost.Cloud.Contracts/Ghost.Cloud.Contracts.csproj" />
  </ItemGroup>
</Project>
