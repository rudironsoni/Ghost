# General Configuration
ASPNETCORE_ENVIRONMENT=Development

# ==========================================
# Proxy Configuration
# ==========================================
GHOST__PROXY__STRATEGY=RoundRobin

# NordVPN (Optional)
GHOST__PROXY__NORDVPN__ENABLED=false
GHOST__PROXY__NORDVPN__TYPE=Socks5
GHOST__PROXY__NORDVPN__USERNAME=your_nordvpn_username
GHOST__PROXY__NORDVPN__PASSWORD=your_nordvpn_password
GHOST__PROXY__NORDVPN__HOSTS='["socks5://nl.socks.nordhold.net:1080","socks5://se.socks.nordhold.net:1080","socks5://us.socks.nordhold.net:1080","socks5://amsterdam.nl.socks.nordhold.net:1080","socks5://atlanta.us.socks.nordhold.net:1080","socks5://chicago.us.socks.nordhold.net:1080","socks5://dallas.us.socks.nordhold.net:1080","socks5://los-angeles.us.socks.nordhold.net:1080","socks5://new-york.us.socks.nordhold.net:1080","socks5://phoenix.us.socks.nordhold.net:1080","socks5://san-francisco.us.socks.nordhold.net:1080","socks5://stockholm.se.socks.nordhold.net:1080"]'

# ProxyScrape (Optional)
GHOST__PROXY__PROXYSCRAPE__ENABLED=false
GHOST__PROXY__PROXYSCRAPE__TYPE=Http
GHOST__PROXY__PROXYSCRAPE__URL=https://api.proxyscrape.com/v2/?request=getproxies&protocol=http&timeout=10000&country=all

# ==========================================
# LinkedIn Configuration
# ==========================================
GHOST__EXTENSIONS__LINKEDIN__ENABLED=true
GHOST__EXTENSIONS__LINKEDIN__COUNTRY=ES
GHOST__EXTENSIONS__LINKEDIN__SCRAPINGSTRATEGY=Hybrid
GHOST__EXTENSIONS__LINKEDIN__PROXYENABLED=true
GHOST__EXTENSIONS__LINKEDIN__WARMUPENABLED=false
GHOST__EXTENSIONS__LINKEDIN__STORAGESTATEPATH=/tmp/linkedin_state.json
GHOST__EXTENSIONS__LINKEDIN__BASEURL=https://www.linkedin.com
GHOST__EXTENSIONS__LINKEDIN__PAGELOADTIMEOUT=00:00:30
GHOST__EXTENSIONS__LINKEDIN__TIMEZONEID=Europe/Madrid
GHOST__EXTENSIONS__LINKEDIN__LOCALE=es-ES

# ==========================================
# Indeed Configuration
# ==========================================
GHOST__EXTENSIONS__INDEED__ENABLED=true
GHOST__EXTENSIONS__INDEED__COUNTRY=ES
GHOST__EXTENSIONS__INDEED__DELAYMINMS=2000
GHOST__EXTENSIONS__INDEED__DELAYMAXMS=5000
GHOST__EXTENSIONS__INDEED__MAXRETRIES=3
GHOST__EXTENSIONS__INDEED__APIKEY=your_indeed_api_key_here

# ==========================================
# Glassdoor Configuration
# ==========================================
GHOST__EXTENSIONS__GLASSDOOR__ENABLED=true
GHOST__EXTENSIONS__GLASSDOOR__COUNTRY=ES
GHOST__EXTENSIONS__GLASSDOOR__DELAYMINMS=3000

# ==========================================
# Google Configuration
# ==========================================
GHOST__EXTENSIONS__GOOGLE__ENABLED=true

# Gemini AI (Generative)
GHOST__EXTENSIONS__GOOGLE__GEMINI__ENABLED=true
GHOST__EXTENSIONS__GOOGLE__GEMINI__BASEURL=gemini.google.com
GHOST__EXTENSIONS__GOOGLE__GEMINI__RESPONSETIMEOUT=00:02:00
GHOST__EXTENSIONS__GOOGLE__GEMINI__DEFAULTMODEL=gemini-pro

# Google Jobs Scraper
GHOST__EXTENSIONS__GOOGLE__JOBS__ENABLED=true
GHOST__EXTENSIONS__GOOGLE__JOBS__COUNTRY=ES
GHOST__EXTENSIONS__GOOGLE__JOBS__MINDELAYMS=1000
GHOST__EXTENSIONS__GOOGLE__JOBS__MAXDELAYMS=3000

# ==========================================
# InfoJobs Configuration (Spanish Platform)
# ==========================================
GHOST__EXTENSIONS__INFOJOBS__ENABLED=true
GHOST__EXTENSIONS__INFOJOBS__COUNTRY=ES
GHOST__EXTENSIONS__INFOJOBS__MINDELAYMS=1000
GHOST__EXTENSIONS__INFOJOBS__MAXDELAYMS=3000
# Get API credentials from: https://developer.infojobs.net/
GHOST__EXTENSIONS__INFOJOBS__CLIENTID=your_infojobs_client_id
GHOST__EXTENSIONS__INFOJOBS__CLIENTSECRET=your_infojobs_client_secret

# ==========================================
# Tecnoempleo Configuration (Spanish Platform)
# ==========================================
GHOST__EXTENSIONS__TECNOEMPLEO__ENABLED=true
GHOST__EXTENSIONS__TECNOEMPLEO__COUNTRY=ES
GHOST__EXTENSIONS__TECNOEMPLEO__ENABLERATELIMITING=true
# Contact Tecnoempleo for API credentials
GHOST__EXTENSIONS__TECNOEMPLEO__CLIENTID=your_tecnoempleo_client_id
GHOST__EXTENSIONS__TECNOEMPLEO__CLIENTSECRET=your_tecnoempleo_client_secret
