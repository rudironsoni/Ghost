### Multi-Strategy Scraping
# Try multiple extraction strategies
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "Multi-Strategy Spider",
  "targets": [
    { "url": "https://example.com/product" }
  ],
  "extraction": {
    "strategies": [
      {
        "name": "Strategy1",
        "priority": 1,
        "entities": [
          {
            "name": "Product",
            "fields": [
              {
                "name": "Price",
                "selector": { "type": "css", "expression": ".price-v1" }
              }
            ]
          }
        ]
      },
      {
        "name": "Strategy2",
        "priority": 2,
        "entities": [
          {
            "name": "Product",
            "fields": [
              {
                "name": "Price",
                "selector": { "type": "css", "expression": ".price-v2" }
              }
            ]
          }
        ]
      }
    ]
  }
}

