### JavaScript Rendering with Wait
# Scrape SPA/PWA with JavaScript rendering
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "JavaScript Rendering Spider",
  "description": "Scrape single-page application with dynamic content",
  "content": {
    "type": "javascript",
    "javascript": {
      "waitFor": ".content-loaded",
      "waitTimeout": 10000,
      "enableJavaScript": true
    }
  },
  "targets": [
    { "url": "https://spa-example.com" }
  ],
  "extraction": {
    "entities": [
      {
        "name": "DynamicContent",
        "fields": [
          {
            "name": "Title",
            "selector": { "type": "css", "expression": ".dynamic-title" }
          },
          {
            "name": "Items",
            "selector": { "type": "css", "expression": ".item-list .item" },
            "multiple": true
          }
        ]
      }
    ]
  }
}

###

### Deep Crawling with Link Following
# Crawl site by following links
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "Deep Crawl Spider",
  "targets": [
    { "url": "https://example.com" }
  ],
  "navigation": {
    "followLinks": {
      "enabled": true,
      "selector": "a[href]",
      "maxDepth": 3,
      "allowedDomains": ["example.com"],
      "excludePatterns": ["/logout", "/cart", "/checkout"]
    }
  },
  "extraction": {
    "entities": [
      {
        "name": "Page",
        "fields": [
          {
            "name": "Url",
            "selector": { "type": "meta", "expression": "url" }
          },
          {
            "name": "Title",
            "selector": { "type": "css", "expression": "h1" }
          }
        ]
      }
    ]
  },
  "options": {
    "concurrency": 5,
    "respectRobotsTxt": true
  }
}

###

### Form Submission Spider
# Submit forms and scrape results
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "Form Submission Spider",
  "content": {
    "type": "javascript",
    "javascript": {
      "actions": [
        {
          "type": "fill",
          "selector": "#search-input",
          "value": "test query"
        },
        {
          "type": "click",
          "selector": "#search-button"
        },
        {
          "type": "waitFor",
          "selector": ".search-results"
        }
      ]
    }
  },
  "targets": [
    { "url": "https://example.com/search" }
  ],
  "extraction": {
    "entities": [
      {
        "name": "SearchResult",
        "fields": [
          {
            "name": "Title",
            "selector": { "type": "css", "expression": ".result-title" }
          },
          {
            "name": "Link",
            "selector": { "type": "css", "expression": ".result-link", "attribute": "href" }
          }
        ]
      }
    ]
  }
}

###

### Infinite Scroll Handling
# Handle infinite scroll pages
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "Infinite Scroll Spider",
  "content": {
    "type": "javascript",
    "javascript": {
      "actions": [
        {
          "type": "scroll",
          "direction": "down",
          "iterations": 5,
          "delay": 1000
        }
      ],
      "waitFor": ".items-loaded"
    }
  },
  "targets": [
    { "url": "https://example.com/infinite-scroll" }
  ],
  "extraction": {
    "entities": [
      {
        "name": "Item",
        "fields": [
          {
            "name": "Title",
            "selector": { "type": "css", "expression": ".item-title" }
          }
        ]
      }
    ]
  }
}

###

### Authentication with Cookies
# Scrape authenticated pages with cookies
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "Authenticated Spider",
  "targets": [
    {
      "url": "https://example.com/protected",
      "cookies": [
        {
          "name": "session_id",
          "value": "abc123xyz",
          "domain": "example.com"
        }
      ]
    }
  ],
  "extraction": {
    "entities": [
      {
        "name": "ProtectedContent",
        "fields": [
          {
            "name": "Data",
            "selector": { "type": "css", "expression": ".protected-data" }
          }
        ]
      }
    ]
  }
}

