### Screenshot Capture
# Capture screenshots while scraping
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "Screenshot Spider",
  "content": {
    "type": "javascript",
    "javascript": {
      "captureScreenshot": true,
      "screenshotOptions": {
        "fullPage": true,
        "format": "png"
      }
    }
  },
  "targets": [
    { "url": "https://example.com" }
  ],
  "extraction": {
    "entities": [
      {
        "name": "Page",
        "fields": [
          {
            "name": "Title",
            "selector": { "type": "css", "expression": "h1" }
          }
        ]
      }
    ]
  }
}

###

### Proxy Rotation
# Use proxy rotation for scraping
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "Proxy Rotation Spider",
  "targets": [
    { "url": "https://example.com/page1" },
    { "url": "https://example.com/page2" },
    { "url": "https://example.com/page3" }
  ],
  "options": {
    "proxy": {
      "enabled": true,
      "rotation": "round-robin",
      "servers": [
        "http://proxy1.example.com:8080",
        "http://proxy2.example.com:8080"
      ]
    }
  },
  "extraction": {
    "entities": [
      {
        "name": "Content",
        "fields": [
          {
            "name": "Title",
            "selector": { "type": "css", "expression": "h1" }
          }
        ]
      }
    ]
  }
}

###

### Retry with Backoff
# Configure retry logic with exponential backoff
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "Retry Spider",
  "targets": [
    { "url": "https://unstable-api.example.com" }
  ],
  "options": {
    "retry": {
      "maxAttempts": 5,
      "backoffStrategy": "exponential",
      "initialDelay": 1000,
      "maxDelay": 30000,
      "retryOn": [500, 502, 503, 504]
    }
  },
  "extraction": {
    "entities": [
      {
        "name": "Data",
        "fields": [
          {
            "name": "Content",
            "selector": { "type": "css", "expression": "body" }
          }
        ]
      }
    ]
  }
}

