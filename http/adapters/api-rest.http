### REST API - Basic Authentication
# API with Basic authentication
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "REST Basic Auth Spider",
  "adapter": "rest-api",
  "targets": [
    {
      "url": "https://api.example.com/data",
      "method": "GET",
      "auth": {
        "type": "basic",
        "username": "user",
        "password": "pass"
      }
    }
  ],
  "extraction": {
    "entities": [
      {
        "name": "Data",
        "fields": [
          {
            "name": "Content",
            "selector": { "type": "jsonpath", "expression": "$.content" }
          }
        ]
      }
    ]
  }
}

