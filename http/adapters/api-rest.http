### REST API - API Key Authentication
# API with API key in header
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "REST API Key Spider",
  "adapter": "rest-api",
  "targets": [
    {
      "url": "https://api.example.com/data",
      "method": "GET",
      "headers": {
        "X-API-Key": "your-api-key-here"
      }
    }
  ],
  "extraction": {
    "entities": [
      {
        "name": "Data",
        "fields": [
          {
            "name": "Results",
            "selector": { "type": "jsonpath", "expression": "$.results" }
          }
        ]
      }
    ]
  }
}

###

### REST API - Rate Limited
# Handle rate-limited APIs
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "REST Rate Limited Spider",
  "adapter": "rest-api",
  "targets": [
    {
      "url": "https://api.example.com/data/1"
    },
    {
      "url": "https://api.example.com/data/2"
    },
    {
      "url": "https://api.example.com/data/3"
    }
  ],
  "options": {
    "rateLimit": {
      "maxRequestsPerSecond": 2,
      "respectRetryAfter": true
    }
  },
  "extraction": {
    "entities": [
      {
        "name": "Data",
        "fields": [
          {
            "name": "Content",
            "selector": { "type": "jsonpath", "expression": "$.data" }
          }
        ]
      }
    ]
  }
}

###

### REST API - Nested Endpoints
# Chain multiple API calls
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "REST Nested Spider",
  "adapter": "rest-api",
  "targets": [
    {
      "url": "https://api.example.com/users",
      "method": "GET"
    }
  ],
  "navigation": {
    "followLinks": {
      "enabled": true,
      "linkExtractor": {
        "type": "jsonpath",
        "expression": "$[*].profileUrl"
      },
      "maxDepth": 1
    }
  },
  "extraction": {
    "entities": [
      {
        "name": "UserProfile",
        "fields": [
          {
            "name": "Id",
            "selector": { "type": "jsonpath", "expression": "$.id" }
          },
          {
            "name": "Bio",
            "selector": { "type": "jsonpath", "expression": "$.bio" }
          }
        ]
      }
    ]
  }
}

