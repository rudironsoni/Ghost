### REST API - PUT Request
# Update resource with PUT
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "REST PUT Spider",
  "adapter": "rest-api",
  "targets": [
    {
      "url": "https://api.example.com/users/123",
      "method": "PUT",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "name": "Jane Doe",
        "email": "jane@example.com"
      }
    }
  ],
  "extraction": {
    "entities": [
      {
        "name": "UpdatedUser",
        "fields": [
          {
            "name": "Id",
            "selector": { "type": "jsonpath", "expression": "$.id" }
          },
          {
            "name": "UpdatedAt",
            "selector": { "type": "jsonpath", "expression": "$.updatedAt" }
          }
        ]
      }
    ]
  }
}

