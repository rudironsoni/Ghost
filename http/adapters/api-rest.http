### REST API - Bearer Authentication
# API with Bearer token authentication
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "REST Bearer Auth Spider",
  "adapter": "rest-api",
  "targets": [
    {
      "url": "https://api.example.com/protected/data",
      "method": "GET",
      "headers": {
        "Authorization": "Bearer api-token-here"
      }
    }
  ],
  "extraction": {
    "entities": [
      {
        "name": "ProtectedData",
        "fields": [
          {
            "name": "Data",
            "selector": { "type": "jsonpath", "expression": "$.data" }
          }
        ]
      }
    ]
  }
}

