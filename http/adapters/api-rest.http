### REST API - DELETE Request
# Delete resource
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "REST DELETE Spider",
  "adapter": "rest-api",
  "targets": [
    {
      "url": "https://api.example.com/users/123",
      "method": "DELETE"
    }
  ],
  "extraction": {
    "entities": [
      {
        "name": "DeleteResult",
        "fields": [
          {
            "name": "Success",
            "selector": { "type": "jsonpath", "expression": "$.success" }
          },
          {
            "name": "Message",
            "selector": { "type": "jsonpath", "expression": "$.message" }
          }
        ]
      }
    ]
  }
}

###

### REST API - Query Parameters
# GET with query parameters
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "REST Query Params Spider",
  "adapter": "rest-api",
  "targets": [
    {
      "url": "https://api.example.com/users",
      "method": "GET",
      "queryParams": {
        "page": "1",
        "limit": "10",
        "sort": "name",
        "filter": "active"
      }
    }
  ],
  "extraction": {
    "entities": [
      {
        "name": "User",
        "fields": [
          {
            "name": "Id",
            "selector": { "type": "jsonpath", "expression": "$.data[*].id" }
          },
          {
            "name": "Name",
            "selector": { "type": "jsonpath", "expression": "$.data[*].name" }
          }
        ]
      }
    ]
  }
}

###

### REST API - Pagination
# Handle paginated API responses
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "REST Pagination Spider",
  "adapter": "rest-api",
  "targets": [
    {
      "url": "https://api.example.com/posts",
      "method": "GET",
      "queryParams": {
        "page": "1",
        "perPage": "20"
      }
    }
  ],
  "navigation": {
    "pagination": {
      "type": "page-number",
      "pageParam": "page",
      "maxPages": 10,
      "hasNextPath": "$.pagination.hasNext"
    }
  },
  "extraction": {
    "entities": [
      {
        "name": "Post",
        "fields": [
          {
            "name": "Id",
            "selector": { "type": "jsonpath", "expression": "$.data[*].id" }
          },
          {
            "name": "Title",
            "selector": { "type": "jsonpath", "expression": "$.data[*].title" }
          }
        ]
      }
    ]
  }
}

