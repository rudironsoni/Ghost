### REST API - GET Request
# Simple GET request to REST API
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "REST GET Spider",
  "adapter": "rest-api",
  "targets": [
    {
      "url": "https://api.example.com/users",
      "method": "GET"
    }
  ],
  "extraction": {
    "entities": [
      {
        "name": "User",
        "fields": [
          {
            "name": "Id",
            "selector": { "type": "jsonpath", "expression": "$[*].id" }
          },
          {
            "name": "Name",
            "selector": { "type": "jsonpath", "expression": "$[*].name" }
          },
          {
            "name": "Email",
            "selector": { "type": "jsonpath", "expression": "$[*].email" }
          }
        ]
      }
    ]
  }
}

###

### REST API - POST Request
# POST request with JSON body
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "REST POST Spider",
  "adapter": "rest-api",
  "targets": [
    {
      "url": "https://api.example.com/users",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "name": "John Doe",
        "email": "john@example.com",
        "role": "user"
      }
    }
  ],
  "extraction": {
    "entities": [
      {
        "name": "CreatedUser",
        "fields": [
          {
            "name": "Id",
            "selector": { "type": "jsonpath", "expression": "$.id" }
          },
          {
            "name": "Name",
            "selector": { "type": "jsonpath", "expression": "$.name" }
          }
        ]
      }
    ]
  }
}

