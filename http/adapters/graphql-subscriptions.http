### GraphQL - Subscription with Batching
# Batch subscription updates
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "GraphQL Batched Subscription Spider",
  "adapter": "graphql-subscription",
  "targets": [
    {
      "url": "wss://api.example.com/graphql",
      "protocol": "websocket",
      "body": {
        "query": "subscription OnOrderUpdate { orderUpdated { id status items { name quantity } total } }",
        "variables": {}
      }
    }
  ],
  "options": {
    "subscriptionDuration": 60000,
    "batching": {
      "enabled": true,
      "batchSize": 10,
      "batchTimeout": 5000
    }
  },
  "extraction": {
    "entities": [
      {
        "name": "Order",
        "fields": [
          {
            "name": "Id",
            "selector": { "type": "jsonpath", "expression": "$.data.orderUpdated.id" }
          },
          {
            "name": "Status",
            "selector": { "type": "jsonpath", "expression": "$.data.orderUpdated.status" }
          },
          {
            "name": "Total",
            "selector": { "type": "jsonpath", "expression": "$.data.orderUpdated.total" }
          }
        ]
      }
    ]
  }
}

###

### GraphQL - Subscription with Filtering
# Client-side filtering of subscription data
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "GraphQL Filtered Subscription Spider",
  "adapter": "graphql-subscription",
  "targets": [
    {
      "url": "wss://api.example.com/graphql",
      "protocol": "websocket",
      "body": {
        "query": "subscription OnComment { commentAdded { id text author { name } post { id title } } }",
        "variables": {}
      }
    }
  ],
  "options": {
    "subscriptionDuration": 60000,
    "filter": {
      "field": "$.data.commentAdded.post.id",
      "operator": "equals",
      "value": "123"
    }
  },
  "extraction": {
    "entities": [
      {
        "name": "Comment",
        "fields": [
          {
            "name": "Id",
            "selector": { "type": "jsonpath", "expression": "$.data.commentAdded.id" }
          },
          {
            "name": "Text",
            "selector": { "type": "jsonpath", "expression": "$.data.commentAdded.text" }
          }
        ]
      }
    ]
  }
}

###

### GraphQL - Subscription with Transformation
# Transform subscription data before extraction
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "GraphQL Transformed Subscription Spider",
  "adapter": "graphql-subscription",
  "targets": [
    {
      "url": "wss://api.example.com/graphql",
      "protocol": "websocket",
      "body": {
        "query": "subscription OnSensorData { sensorDataReceived { sensorId temperature humidity timestamp } }",
        "variables": {}
      }
    }
  ],
  "options": {
    "subscriptionDuration": 120000
  },
  "extraction": {
    "entities": [
      {
        "name": "SensorReading",
        "fields": [
          {
            "name": "SensorId",
            "selector": { "type": "jsonpath", "expression": "$.data.sensorDataReceived.sensorId" }
          },
          {
            "name": "Temperature",
            "selector": { "type": "jsonpath", "expression": "$.data.sensorDataReceived.temperature" },
            "transform": "number"
          },
          {
            "name": "Humidity",
            "selector": { "type": "jsonpath", "expression": "$.data.sensorDataReceived.humidity" },
            "transform": "number"
          }
        ]
      }
    ]
  }
}

