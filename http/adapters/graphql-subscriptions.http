### GraphQL - Subscription with Authentication
# Authenticated subscription connection
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "GraphQL Authenticated Subscription Spider",
  "adapter": "graphql-subscription",
  "targets": [
    {
      "url": "wss://api.example.com/graphql",
      "protocol": "websocket",
      "headers": {
        "Authorization": "Bearer user-token-here"
      },
      "body": {
        "query": "subscription OnPrivateMessage { privateMessageReceived { id text sender { name } } }",
        "variables": {}
      }
    }
  ],
  "options": {
    "subscriptionDuration": 60000
  },
  "extraction": {
    "entities": [
      {
        "name": "PrivateMessage",
        "fields": [
          {
            "name": "Id",
            "selector": { "type": "jsonpath", "expression": "$.data.privateMessageReceived.id" }
          },
          {
            "name": "Text",
            "selector": { "type": "jsonpath", "expression": "$.data.privateMessageReceived.text" }
          }
        ]
      }
    ]
  }
}

###

### GraphQL - Subscription with Reconnect
# Auto-reconnect on connection loss
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "GraphQL Reconnecting Subscription Spider",
  "adapter": "graphql-subscription",
  "targets": [
    {
      "url": "wss://api.example.com/graphql",
      "protocol": "websocket",
      "body": {
        "query": "subscription OnStockPrice($symbol: String!) { stockPriceUpdated(symbol: $symbol) { symbol price change timestamp } }",
        "variables": {
          "symbol": "AAPL"
        }
      }
    }
  ],
  "options": {
    "subscriptionDuration": 300000,
    "reconnect": {
      "enabled": true,
      "maxAttempts": 5,
      "delay": 5000
    }
  },
  "extraction": {
    "entities": [
      {
        "name": "StockPrice",
        "fields": [
          {
            "name": "Symbol",
            "selector": { "type": "jsonpath", "expression": "$.data.stockPriceUpdated.symbol" }
          },
          {
            "name": "Price",
            "selector": { "type": "jsonpath", "expression": "$.data.stockPriceUpdated.price" }
          },
          {
            "name": "Change",
            "selector": { "type": "jsonpath", "expression": "$.data.stockPriceUpdated.change" }
          }
        ]
      }
    ]
  }
}

