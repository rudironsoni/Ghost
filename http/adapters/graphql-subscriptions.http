### GraphQL - Basic Subscription
# Subscribe to real-time updates
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "GraphQL Subscription Spider",
  "adapter": "graphql-subscription",
  "targets": [
    {
      "url": "wss://api.example.com/graphql",
      "protocol": "websocket",
      "body": {
        "query": "subscription OnNewMessage { messageAdded { id text author { name } createdAt } }",
        "variables": {}
      }
    }
  ],
  "options": {
    "subscriptionDuration": 30000,
    "maxMessages": 10
  },
  "extraction": {
    "entities": [
      {
        "name": "Message",
        "fields": [
          {
            "name": "Id",
            "selector": { "type": "jsonpath", "expression": "$.data.messageAdded.id" }
          },
          {
            "name": "Text",
            "selector": { "type": "jsonpath", "expression": "$.data.messageAdded.text" }
          },
          {
            "name": "Author",
            "selector": { "type": "jsonpath", "expression": "$.data.messageAdded.author.name" }
          }
        ]
      }
    ]
  }
}

###

### GraphQL - Subscription with Variables
# Subscribe with filter parameters
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "GraphQL Filtered Subscription Spider",
  "adapter": "graphql-subscription",
  "targets": [
    {
      "url": "wss://api.example.com/graphql",
      "protocol": "websocket",
      "body": {
        "query": "subscription OnUserMessage($userId: ID!) { messageAdded(userId: $userId) { id text timestamp } }",
        "variables": {
          "userId": "123"
        }
      }
    }
  ],
  "options": {
    "subscriptionDuration": 60000,
    "maxMessages": 50
  },
  "extraction": {
    "entities": [
      {
        "name": "UserMessage",
        "fields": [
          {
            "name": "Id",
            "selector": { "type": "jsonpath", "expression": "$.data.messageAdded.id" }
          },
          {
            "name": "Text",
            "selector": { "type": "jsonpath", "expression": "$.data.messageAdded.text" }
          }
        ]
      }
    ]
  }
}

###

### GraphQL - Multiple Subscriptions
# Subscribe to multiple event types
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "GraphQL Multi-Subscription Spider",
  "adapter": "graphql-subscription",
  "targets": [
    {
      "url": "wss://api.example.com/graphql",
      "protocol": "websocket",
      "body": {
        "query": "subscription OnChatEvents { messageAdded { id text } userJoined { id name } userLeft { id name } }",
        "variables": {}
      }
    }
  ],
  "options": {
    "subscriptionDuration": 120000
  },
  "extraction": {
    "entities": [
      {
        "name": "ChatEvent",
        "fields": [
          {
            "name": "MessageId",
            "selector": { "type": "jsonpath", "expression": "$.data.messageAdded.id" }
          },
          {
            "name": "JoinedUser",
            "selector": { "type": "jsonpath", "expression": "$.data.userJoined.name" }
          },
          {
            "name": "LeftUser",
            "selector": { "type": "jsonpath", "expression": "$.data.userLeft.name" }
          }
        ]
      }
    ]
  }
}

