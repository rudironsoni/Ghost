### GraphQL - Complex Nested Mutation
# Mutation with nested object creation
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "GraphQL Nested Mutation Spider",
  "adapter": "graphql",
  "targets": [
    {
      "url": "https://api.example.com/graphql",
      "method": "POST",
      "body": {
        "query": "mutation CreateUserWithProfile($input: CreateUserInput!) { createUser(input: $input) { id name profile { bio avatar socialLinks { twitter github } } } }",
        "variables": {
          "input": {
            "name": "John Doe",
            "email": "john@example.com",
            "profile": {
              "bio": "Software Developer",
              "avatar": "https://example.com/avatar.jpg",
              "socialLinks": {
                "twitter": "@johndoe",
                "github": "johndoe"
              }
            }
          }
        }
      }
    }
  ],
  "extraction": {
    "entities": [
      {
        "name": "UserWithProfile",
        "fields": [
          {
            "name": "Id",
            "selector": { "type": "jsonpath", "expression": "$.data.createUser.id" }
          },
          {
            "name": "Bio",
            "selector": { "type": "jsonpath", "expression": "$.data.createUser.profile.bio" }
          }
        ]
      }
    ]
  }
}

