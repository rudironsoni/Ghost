### GraphQL - Conditional Mutation
# Mutation with conditional logic
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "GraphQL Conditional Mutation Spider",
  "adapter": "graphql",
  "targets": [
    {
      "url": "https://api.example.com/graphql",
      "method": "POST",
      "body": {
        "query": "mutation UpsertUser($id: ID, $name: String!, $email: String!) { upsertUser(id: $id, name: $name, email: $email) { id name email isNew } }",
        "variables": {
          "id": null,
          "name": "John Doe",
          "email": "john@example.com"
        }
      }
    }
  ],
  "extraction": {
    "entities": [
      {
        "name": "UpsertedUser",
        "fields": [
          {
            "name": "Id",
            "selector": { "type": "jsonpath", "expression": "$.data.upsertUser.id" }
          },
          {
            "name": "IsNew",
            "selector": { "type": "jsonpath", "expression": "$.data.upsertUser.isNew" }
          }
        ]
      }
    ]
  }
}

