### GraphQL - Simple Mutation
# Execute a basic GraphQL mutation
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "GraphQL Mutation Spider",
  "adapter": "graphql",
  "targets": [
    {
      "url": "https://api.example.com/graphql",
      "method": "POST",
      "body": {
        "query": "mutation CreateUser($name: String!, $email: String!) { createUser(name: $name, email: $email) { id name email createdAt } }",
        "variables": {
          "name": "John Doe",
          "email": "john@example.com"
        }
      }
    }
  ],
  "extraction": {
    "entities": [
      {
        "name": "CreatedUser",
        "fields": [
          {
            "name": "Id",
            "selector": { "type": "jsonpath", "expression": "$.data.createUser.id" }
          },
          {
            "name": "Name",
            "selector": { "type": "jsonpath", "expression": "$.data.createUser.name" }
          }
        ]
      }
    ]
  }
}

