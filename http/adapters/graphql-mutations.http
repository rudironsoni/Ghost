### GraphQL - Delete Mutation
# Delete data with mutation
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "GraphQL Delete Spider",
  "adapter": "graphql",
  "targets": [
    {
      "url": "https://api.example.com/graphql",
      "method": "POST",
      "body": {
        "query": "mutation DeleteUser($id: ID!) { deleteUser(id: $id) { success message } }",
        "variables": {
          "id": "123"
        }
      }
    }
  ],
  "extraction": {
    "entities": [
      {
        "name": "DeleteResult",
        "fields": [
          {
            "name": "Success",
            "selector": { "type": "jsonpath", "expression": "$.data.deleteUser.success" }
          },
          {
            "name": "Message",
            "selector": { "type": "jsonpath", "expression": "$.data.deleteUser.message" }
          }
        ]
      }
    ]
  }
}

###

### GraphQL - Batch Create Mutation
# Create multiple items in one mutation
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "GraphQL Batch Create Spider",
  "adapter": "graphql",
  "targets": [
    {
      "url": "https://api.example.com/graphql",
      "method": "POST",
      "body": {
        "query": "mutation CreatePosts($posts: [PostInput!]!) { createPosts(posts: $posts) { id title author { name } } }",
        "variables": {
          "posts": [
            { "title": "First Post", "content": "Content 1", "authorId": "123" },
            { "title": "Second Post", "content": "Content 2", "authorId": "123" },
            { "title": "Third Post", "content": "Content 3", "authorId": "123" }
          ]
        }
      }
    }
  ],
  "extraction": {
    "entities": [
      {
        "name": "CreatedPosts",
        "fields": [
          {
            "name": "Ids",
            "selector": { "type": "jsonpath", "expression": "$.data.createPosts[*].id" }
          },
          {
            "name": "Titles",
            "selector": { "type": "jsonpath", "expression": "$.data.createPosts[*].title" }
          }
        ]
      }
    ]
  }
}

