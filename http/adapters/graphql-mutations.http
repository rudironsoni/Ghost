### GraphQL - Update Mutation
# Update existing data with mutation
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "GraphQL Update Spider",
  "adapter": "graphql",
  "targets": [
    {
      "url": "https://api.example.com/graphql",
      "method": "POST",
      "body": {
        "query": "mutation UpdateUser($id: ID!, $name: String) { updateUser(id: $id, name: $name) { id name email updatedAt } }",
        "variables": {
          "id": "123",
          "name": "Jane Doe"
        }
      }
    }
  ],
  "extraction": {
    "entities": [
      {
        "name": "UpdatedUser",
        "fields": [
          {
            "name": "Id",
            "selector": { "type": "jsonpath", "expression": "$.data.updateUser.id" }
          },
          {
            "name": "UpdatedAt",
            "selector": { "type": "jsonpath", "expression": "$.data.updateUser.updatedAt" }
          }
        ]
      }
    ]
  }
}

