### GraphQL - Multiple Mutations
# Execute multiple mutations sequentially
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "GraphQL Multi-Mutation Spider",
  "adapter": "graphql",
  "targets": [
    {
      "url": "https://api.example.com/graphql",
      "method": "POST",
      "body": {
        "query": "mutation { first: createUser(name: \"Alice\", email: \"alice@example.com\") { id } second: createUser(name: \"Bob\", email: \"bob@example.com\") { id } }",
        "variables": {}
      }
    }
  ],
  "extraction": {
    "entities": [
      {
        "name": "CreatedUsers",
        "fields": [
          {
            "name": "FirstId",
            "selector": { "type": "jsonpath", "expression": "$.data.first.id" }
          },
          {
            "name": "SecondId",
            "selector": { "type": "jsonpath", "expression": "$.data.second.id" }
          }
        ]
      }
    ]
  }
}

###

### GraphQL - Mutation with Error Handling
# Handle mutation errors gracefully
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "GraphQL Mutation Error Spider",
  "adapter": "graphql",
  "targets": [
    {
      "url": "https://api.example.com/graphql",
      "method": "POST",
      "body": {
        "query": "mutation CreateUser($email: String!) { createUser(email: $email) { ... on User { id email } ... on ValidationError { field message } } }",
        "variables": {
          "email": "invalid-email"
        }
      }
    }
  ],
  "options": {
    "handleErrors": true
  },
  "extraction": {
    "entities": [
      {
        "name": "MutationResult",
        "fields": [
          {
            "name": "UserId",
            "selector": { "type": "jsonpath", "expression": "$.data.createUser.id" }
          },
          {
            "name": "Error",
            "selector": { "type": "jsonpath", "expression": "$.data.createUser.message" }
          }
        ]
      }
    ]
  }
}

