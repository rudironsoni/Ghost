### GraphQL - Mutation with File Upload
# Upload file with mutation
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "GraphQL File Upload Spider",
  "adapter": "graphql",
  "targets": [
    {
      "url": "https://api.example.com/graphql",
      "method": "POST",
      "body": {
        "query": "mutation UploadFile($file: Upload!) { uploadFile(file: $file) { id filename url size } }",
        "variables": {
          "file": null
        }
      },
      "files": {
        "file": "/path/to/file.txt"
      }
    }
  ],
  "extraction": {
    "entities": [
      {
        "name": "UploadedFile",
        "fields": [
          {
            "name": "Id",
            "selector": { "type": "jsonpath", "expression": "$.data.uploadFile.id" }
          },
          {
            "name": "Url",
            "selector": { "type": "jsonpath", "expression": "$.data.uploadFile.url" }
          }
        ]
      }
    ]
  }
}

