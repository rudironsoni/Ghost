### JavaScript Rendering - Dropdown Selection
# Select options from dropdowns
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "Dropdown Selection Spider",
  "adapter": "javascript",
  "content": {
    "type": "javascript",
    "javascript": {
      "actions": [
        {
          "type": "select",
          "selector": "#category-dropdown",
          "value": "electronics"
        },
        {
          "type": "click",
          "selector": "#apply-filter"
        },
        {
          "type": "waitFor",
          "selector": ".filtered-results"
        }
      ]
    }
  },
  "targets": [
    { "url": "https://example.com/products" }
  ],
  "extraction": {
    "entities": [
      {
        "name": "Product",
        "selector": ".product",
        "fields": [
          {
            "name": "Name",
            "selector": { "type": "css", "expression": ".product-name" }
          }
        ]
      }
    ]
  }
}

