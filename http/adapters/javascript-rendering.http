### JavaScript Rendering - Basic SPA
# Render JavaScript-heavy single-page application
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "SPA Rendering Spider",
  "adapter": "javascript",
  "content": {
    "type": "javascript",
    "javascript": {
      "enableJavaScript": true,
      "waitFor": ".app-loaded",
      "waitTimeout": 10000
    }
  },
  "targets": [
    { "url": "https://spa.example.com" }
  ],
  "extraction": {
    "entities": [
      {
        "name": "Content",
        "fields": [
          {
            "name": "Title",
            "selector": { "type": "css", "expression": ".dynamic-title" }
          }
        ]
      }
    ]
  }
}

