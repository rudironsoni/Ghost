### JavaScript Rendering - Wait for Network Idle
# Wait for network requests to complete
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "Network Idle Spider",
  "adapter": "javascript",
  "content": {
    "type": "javascript",
    "javascript": {
      "waitUntil": "networkidle",
      "waitTimeout": 30000
    }
  },
  "targets": [
    { "url": "https://api-heavy-app.example.com" }
  ],
  "extraction": {
    "entities": [
      {
        "name": "Data",
        "fields": [
          {
            "name": "Content",
            "selector": { "type": "css", "expression": ".api-data" }
          }
        ]
      }
    ]
  }
}

