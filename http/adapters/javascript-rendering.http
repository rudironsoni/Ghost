### JavaScript Rendering - Click Interactions
# Interact with page elements through clicks
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "Click Interaction Spider",
  "adapter": "javascript",
  "content": {
    "type": "javascript",
    "javascript": {
      "actions": [
        {
          "type": "click",
          "selector": "#load-more-button"
        },
        {
          "type": "waitFor",
          "selector": ".new-content"
        }
      ]
    }
  },
  "targets": [
    { "url": "https://example.com/loadmore" }
  ],
  "extraction": {
    "entities": [
      {
        "name": "Item",
        "selector": ".item",
        "fields": [
          {
            "name": "Title",
            "selector": { "type": "css", "expression": ".item-title" }
          }
        ]
      }
    ]
  }
}

