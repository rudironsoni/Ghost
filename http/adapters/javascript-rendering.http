### JavaScript Rendering - Hover Actions
# Trigger hover menus and tooltips
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "Hover Action Spider",
  "adapter": "javascript",
  "content": {
    "type": "javascript",
    "javascript": {
      "actions": [
        {
          "type": "hover",
          "selector": ".menu-item"
        },
        {
          "type": "waitFor",
          "selector": ".submenu"
        },
        {
          "type": "click",
          "selector": ".submenu-item"
        }
      ]
    }
  },
  "targets": [
    { "url": "https://example.com/menu" }
  ],
  "extraction": {
    "entities": [
      {
        "name": "MenuItem",
        "fields": [
          {
            "name": "Title",
            "selector": { "type": "css", "expression": ".submenu-title" }
          }
        ]
      }
    ]
  }
}

###

### JavaScript Rendering - Execute Custom Script
# Run custom JavaScript code
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "Custom Script Spider",
  "adapter": "javascript",
  "content": {
    "type": "javascript",
    "javascript": {
      "actions": [
        {
          "type": "executeScript",
          "script": "window.scrollTo(0, document.body.scrollHeight);"
        },
        {
          "type": "wait",
          "duration": 1000
        },
        {
          "type": "executeScript",
          "script": "document.querySelector('.hidden-content').style.display = 'block';"
        }
      ]
    }
  },
  "targets": [
    { "url": "https://example.com/complex" }
  ],
  "extraction": {
    "entities": [
      {
        "name": "Content",
        "fields": [
          {
            "name": "Text",
            "selector": { "type": "css", "expression": ".hidden-content" }
          }
        ]
      }
    ]
  }
}

