### JavaScript Rendering - Form Filling
# Fill forms and submit
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "Form Filling Spider",
  "adapter": "javascript",
  "content": {
    "type": "javascript",
    "javascript": {
      "actions": [
        {
          "type": "fill",
          "selector": "#username",
          "value": "testuser"
        },
        {
          "type": "fill",
          "selector": "#password",
          "value": "testpass"
        },
        {
          "type": "click",
          "selector": "#login-button"
        },
        {
          "type": "waitForNavigation"
        }
      ]
    }
  },
  "targets": [
    { "url": "https://example.com/login" }
  ],
  "extraction": {
    "entities": [
      {
        "name": "Dashboard",
        "fields": [
          {
            "name": "WelcomeMessage",
            "selector": { "type": "css", "expression": ".welcome" }
          }
        ]
      }
    ]
  }
}

###

### JavaScript Rendering - Scroll to Load
# Scroll down to trigger lazy loading
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "Scroll Loading Spider",
  "adapter": "javascript",
  "content": {
    "type": "javascript",
    "javascript": {
      "actions": [
        {
          "type": "scroll",
          "direction": "down",
          "iterations": 10,
          "delay": 500
        },
        {
          "type": "wait",
          "duration": 2000
        }
      ]
    }
  },
  "targets": [
    { "url": "https://example.com/infinite-scroll" }
  ],
  "extraction": {
    "entities": [
      {
        "name": "Item",
        "selector": ".scroll-item",
        "fields": [
          {
            "name": "Content",
            "selector": { "type": "css", "expression": "." }
          }
        ]
      }
    ]
  }
}

