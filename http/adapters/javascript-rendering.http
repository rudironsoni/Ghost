### JavaScript Rendering - Multiple Tabs
# Handle multiple browser tabs
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "Multi-Tab Spider",
  "adapter": "javascript",
  "content": {
    "type": "javascript",
    "javascript": {
      "actions": [
        {
          "type": "click",
          "selector": "a[target='_blank']"
        },
        {
          "type": "switchToNewTab"
        },
        {
          "type": "waitFor",
          "selector": ".new-page-content"
        }
      ]
    }
  },
  "targets": [
    { "url": "https://example.com/links" }
  ],
  "extraction": {
    "entities": [
      {
        "name": "NewPageContent",
        "fields": [
          {
            "name": "Title",
            "selector": { "type": "css", "expression": "h1" }
          }
        ]
      }
    ]
  }
}

