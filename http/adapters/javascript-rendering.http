### JavaScript Rendering - Modal Interaction
# Handle modal dialogs
POST {{BASE_URL}}/api/spider/execute HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{API_KEY}}

{
  "name": "Modal Interaction Spider",
  "adapter": "javascript",
  "content": {
    "type": "javascript",
    "javascript": {
      "actions": [
        {
          "type": "click",
          "selector": "#open-modal"
        },
        {
          "type": "waitFor",
          "selector": ".modal-content"
        },
        {
          "type": "fill",
          "selector": "#modal-input",
          "value": "test data"
        },
        {
          "type": "click",
          "selector": ".modal-submit"
        }
      ]
    }
  },
  "targets": [
    { "url": "https://example.com/modal" }
  ],
  "extraction": {
    "entities": [
      {
        "name": "Result",
        "fields": [
          {
            "name": "Message",
            "selector": { "type": "css", "expression": ".success-message" }
          }
        ]
      }
    ]
  }
}

