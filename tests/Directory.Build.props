<Project>
  <!-- Test-specific build configuration -->
  <PropertyGroup>
    <!-- TreatWarningsAsErrors is inherited from root, but we need test-specific exceptions -->
  </PropertyGroup>

  <!--
    xUnit1030: Do not call ConfigureAwait(false) in test methods
    CA2007: Consider calling ConfigureAwait on the awaited task

    These rules conflict in test projects. xUnit recommends NOT using ConfigureAwait(false)
    in tests because the test runner handles synchronization context properly.
    We disable CA2007 in test projects to respect xUnit's guidance.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA2007</NoWarn>
  </PropertyGroup>

  <!-- Import parent Directory.Build.props -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
</Project>
