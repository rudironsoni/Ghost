<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Ghost.Smoke.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <NoWarn>$(NoWarn);CA1711;IDE0031;CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Plugin references -->
    <ProjectReference Include="../../../src/Plugins/LinkedIn/Ghost.Plugin.LinkedIn/Ghost.Plugin.LinkedIn.csproj" />
    <ProjectReference Include="../../../src/Plugins/Indeed/Ghost.Plugin.Indeed/Ghost.Plugin.Indeed.csproj" />
    <ProjectReference Include="../../../src/Plugins/Glassdoor/Ghost.Plugin.Glassdoor/Ghost.Plugin.Glassdoor.csproj" />
    <ProjectReference Include="../../../src/Plugins/Google/Ghost.Plugin.Google/Ghost.Plugin.Google.csproj" />
    <ProjectReference Include="../../../src/Plugins/InfoJobs/Ghost.Plugin.InfoJobs/Ghost.Plugin.InfoJobs.csproj" />
    <ProjectReference Include="../../../src/Plugins/Anthropic/Ghost.Plugin.Anthropic/Ghost.Plugin.Anthropic.csproj" />
    <ProjectReference Include="../../../src/Plugins/OpenAI/Ghost.Plugin.OpenAI/Ghost.Plugin.OpenAI.csproj" />
    <ProjectReference Include="../../../src/Plugins/X/Ghost.Plugin.X/Ghost.Plugin.X.csproj" />

    <!-- Contract references -->
    <ProjectReference Include="../../../src/Contracts/Ghost.Contracts.Jobs/Ghost.Contracts.Jobs.csproj" />
    <ProjectReference Include="../../../src/Contracts/Ghost.Contracts.Social/Ghost.Contracts.Social.csproj" />
    <ProjectReference Include="../../../src/Contracts/Ghost.Contracts.News/Ghost.Contracts.News.csproj" />
    <ProjectReference Include="../../../src/Contracts/Ghost.Contracts/Ghost.Contracts.csproj" />

    <!-- Platform references -->
    <ProjectReference Include="../../../src/Platform/Hosting/Ghost.Hosting/Ghost.Hosting.csproj" />
    <ProjectReference Include="../../../src/Platform/Hosting/Ghost.Hosting.WebApi/Ghost.Hosting.WebApi.csproj" />

    <!-- Kernel references -->
    <ProjectReference Include="../../../src/Kernel/Ghost/Ghost.csproj" />

    <!-- WebAPI for integration testing -->
    <ProjectReference Include="../../../src/Apps/Ghost.WebApi/Ghost.WebApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>
</Project>
