# Ghost Web API Configuration
# Copy this file to .env and update with your actual credentials

# InfoJobs API Credentials
INFOJOBS_CLIENT_ID=your_infojobs_client_id_here
INFOJOBS_CLIENT_SECRET=your_infojobs_client_secret_here

# Tecnoempleo API Credentials
TECNOEMPLEO_CLIENT_ID=your_tecnoempleo_client_id_here
TECNOEMPLEO_CLIENT_SECRET=your_tecnoempleo_client_secret_here

# Proxy Configuration (Optional)
# GHOST_PROXY_STRATEGY=roundrobin
# GHOST_PROXY_SOURCES__0__ENABLED=true
# GHOST_PROXY_SOURCES__0__URL=https://proxy-service.com/api/proxies
# GHOST_PROXY_SOURCES__0__API_KEY=your_proxy_api_key
