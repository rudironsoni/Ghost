# DigitalOcean API token - Get from https://cloud.digitalocean.com/account/api/tokens
do_token = "your-digitalocean-api-token-here"

# Droplet configuration
droplet_name = "ghost-platform-miser"
droplet_size = "s-2vcpu-4gb"  # 2 vCPU, 4GB RAM, 80GB SSD
region       = "nyc3"          # New York 3
image        = "ubuntu-22-04-x64"

# SSH keys - Add your SSH key fingerprints from DigitalOcean Console
# ssh_keys = ["aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"]

# Tags for organization
tags = ["miser-mode", "ghost-platform", "terraform"]

# Monitoring and backups
monitoring = true
backups    = false  # Set to true to enable automated backups (adds cost)
