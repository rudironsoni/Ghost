[Unit]
Description=Ghost Platform Ultra Miser Mode
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ ghost_install_dir }}/deploy/docker
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose restart
TimeoutStartSec=300
User={{ ghost_user }}
Group={{ ghost_group }}

[Install]
WantedBy=multi-user.target
