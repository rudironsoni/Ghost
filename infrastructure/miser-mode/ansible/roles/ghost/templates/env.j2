# Ghost Platform Ultra Miser Mode - Environment Configuration
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

# Database Configuration
DB_PASSWORD={{ db_password }}

# RabbitMQ Configuration
RABBITMQ_USER={{ rabbitmq_user }}
RABBITMQ_PASSWORD={{ rabbitmq_password }}
RABBITMQ_COOKIE={{ rabbitmq_cookie }}

# Grafana Configuration
GRAFANA_PASSWORD={{ grafana_password }}

# Platform Configuration
LINKEDIN_ENABLED={{ linkedin_enabled | lower }}
LINKEDIN_COUNTRY={{ linkedin_country }}
INDEED_ENABLED={{ indeed_enabled | lower }}
INDEED_COUNTRY={{ indeed_country }}
GLASSDOOR_ENABLED={{ glassdoor_enabled | lower }}
GOOGLE_ENABLED={{ google_enabled | lower }}
INFOJOBS_ENABLED={{ infojobs_enabled | lower }}

{% if backup_s3_bucket is defined %}
# S3 Backup Configuration
S3_BUCKET={{ backup_s3_bucket }}
AWS_ACCESS_KEY={{ backup_s3_access_key | default('') }}
AWS_SECRET_KEY={{ backup_s3_secret_key | default('') }}
S3_ENDPOINT={{ backup_s3_endpoint | default('s3.amazonaws.com') }}
{% endif %}

# Domain Configuration
{% if domain_name is defined and domain_name != "" %}
DOMAIN_NAME={{ domain_name }}
{% endif %}
