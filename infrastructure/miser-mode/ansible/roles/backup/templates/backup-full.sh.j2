#!/bin/bash
# Ghost Platform - Full System Backup Script
# Managed by Ansible - DO NOT EDIT MANUALLY

set -euo pipefail

BACKUP_DIR="{{ ghost_backup_dir }}"
DATE=$(date +%Y%m%d_%H%M%S)
ARCHIVE_FILE="${BACKUP_DIR}/ghost_full_backup_${DATE}.tar.gz"
LOG_FILE="{{ ghost_log_dir }}/backup.log"

log() {
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG_FILE"
}

log "Starting full backup..."

# Run individual backups first
/usr/local/bin/ghost-backup/backup-postgres.sh
/usr/local/bin/ghost-backup/backup-redis.sh

# Create full archive
log "Creating full system archive..."
tar -czf "${ARCHIVE_FILE}" \
    -C {{ ghost_install_dir }} . \
    --exclude='*.log' \
    --exclude='node_modules' \
    2>> "$LOG_FILE"

log "Full backup completed: ${ARCHIVE_FILE}"
log "Archive size: $(du -h "${ARCHIVE_FILE}" | cut -f1)"

# Create latest symlink
ln -sf "$(basename "${ARCHIVE_FILE}")" "${BACKUP_DIR}/latest-full.tar.gz"

# Clean up old full backups (keep fewer of these)
find "${BACKUP_DIR}" -name "ghost_full_backup_*.tar.gz" -mtime +7 -delete

log "Full backup completed successfully"
