#!/bin/bash
# Ghost Platform - S3 Backup Sync Script
# Managed by Ansible - DO NOT EDIT MANUALLY

set -euo pipefail

BACKUP_DIR="{{ ghost_backup_dir }}"
S3_BUCKET="{{ backup_s3_bucket }}"
S3_PATH="ghost-backups/{{ inventory_hostname }}"
LOG_FILE="{{ ghost_log_dir }}/backup.log"

log() {
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG_FILE"
}

log "Starting S3 sync..."

# Sync backups to S3
if aws s3 sync "${BACKUP_DIR}" "s3://${S3_BUCKET}/${S3_PATH}" \
    --exclude "*" \
    --include "*.sql.gz" \
    --include "*.rdb.gz" \
    --include "*.tar.gz" \
    --storage-class STANDARD_IA \
    --no-progress 2>> "$LOG_FILE"; then
    log "S3 sync completed successfully"
else
    log "ERROR: S3 sync failed!"
    exit 1
fi

log "S3 backup sync completed"
