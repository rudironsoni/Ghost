#!/bin/bash
# Ghost Platform - PostgreSQL Backup Script
# Managed by Ansible - DO NOT EDIT MANUALLY

set -euo pipefail

BACKUP_DIR="{{ ghost_backup_dir }}/postgres"
RETENTION_DAYS={{ backup_retention_days }}
DATE=$(date +%Y%m%d_%H%M%S)
BACKUP_FILE="postgres_backup_${DATE}.sql.gz"
LOG_FILE="{{ ghost_log_dir }}/backup.log"

log() {
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG_FILE"
}

log "Starting PostgreSQL backup..."

# Create backup using Docker exec
if docker exec ghost-postgres pg_dumpall -U ghost | pigz > "${BACKUP_DIR}/${BACKUP_FILE}"; then
    log "Backup completed: ${BACKUP_FILE}"
    log "Backup size: $(du -h "${BACKUP_DIR}/${BACKUP_FILE}" | cut -f1)"
else
    log "ERROR: Backup failed!"
    exit 1
fi

# Create latest symlink
ln -sf "${BACKUP_FILE}" "${BACKUP_DIR}/latest.sql.gz"

# Clean up old backups
find "${BACKUP_DIR}" -name "postgres_backup_*.sql.gz" -mtime +${RETENTION_DAYS} -delete
log "Cleaned up backups older than ${RETENTION_DAYS} days"

log "PostgreSQL backup completed successfully"
