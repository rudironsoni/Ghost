#!/bin/bash
# Ghost Platform - Redis Backup Script
# Managed by Ansible - DO NOT EDIT MANUALLY

set -euo pipefail

BACKUP_DIR="{{ ghost_backup_dir }}/redis"
RETENTION_DAYS={{ backup_retention_days }}
DATE=$(date +%Y%m%d_%H%M%S)
BACKUP_FILE="redis_backup_${DATE}.rdb.gz"
LOG_FILE="{{ ghost_log_dir }}/backup.log"

log() {
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG_FILE"
}

log "Starting Redis backup..."

# Trigger Redis BGSAVE
docker exec ghost-redis redis-cli BGSAVE

# Wait for save to complete
sleep 5

# Copy RDB file
if docker cp ghost-redis:/data/dump.rdb - | pigz > "${BACKUP_DIR}/${BACKUP_FILE}"; then
    log "Backup completed: ${BACKUP_FILE}"
    log "Backup size: $(du -h "${BACKUP_DIR}/${BACKUP_FILE}" | cut -f1)"
else
    log "ERROR: Backup failed!"
    exit 1
fi

# Create latest symlink
ln -sf "${BACKUP_FILE}" "${BACKUP_DIR}/latest.rdb.gz"

# Clean up old backups
find "${BACKUP_DIR}" -name "redis_backup_*.rdb.gz" -mtime +${RETENTION_DAYS} -delete
log "Cleaned up backups older than ${RETENTION_DAYS} days"

log "Redis backup completed successfully"
