---
# Example Inventory File for Ghost Platform Ultra Miser Mode
#
# Copy this file and customize for your deployment:
#   cp hosts.yml.example hosts.yml
#
# Usage:
#   ansible-playbook -i inventory/hosts.yml setup.yml
#   ansible-playbook -i inventory/hosts.yml deploy.yml

all:
  children:
    ghost_servers:
      hosts:
        ghost-prod:
          ansible_host: 192.168.1.100
          ansible_user: ubuntu
          ansible_port: 22
          ansible_python_interpreter: /usr/bin/python3
          
          # Server-specific overrides
          domain_name: ghost.example.com
          enable_ssl: true
          admin_email: admin@example.com
          
          # Backup configuration
          backup_s3_bucket: my-ghost-backups
          backup_s3_region: us-east-1
          
          # Platform features
          linkedin_enabled: true
          indeed_enabled: true
        
        # ghost-staging:
        #   ansible_host: 192.168.1.101
        #   ansible_user: ubuntu
        #   domain_name: ghost-staging.example.com
        #   enable_ssl: false
      
      vars:
        # Group-level variables for all Ghost servers
        docker_network_range: "172.20.0.0/16"
        timezone: "America/New_York"
