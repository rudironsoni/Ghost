# ============================================================================
# Ghost Platform - Ultra Miser Mode Environment Configuration
# Copy this file to .env and customize for your deployment
# ============================================================================

# =============================================================================
# SECURITY - CRITICAL: Change these before production deployment!
# =============================================================================

# PostgreSQL Database Password
DB_PASSWORD=your-super-secure-password-here-change-me

# RabbitMQ Credentials
RABBITMQ_USER=ghost
RABBITMQ_PASSWORD=your-rabbitmq-password-here
RABBITMQ_COOKIE=unique-erlang-cookie-min-20-chars-long

# Grafana Admin Password
GRAFANA_PASSWORD=your-grafana-password

# =============================================================================
# PLATFORM API KEYS (Required for platform adapters)
# =============================================================================

# LinkedIn (Optional - if enabled)
LINKEDIN_USERNAME=
LINKEDIN_PASSWORD=

# Indeed (Optional - if enabled)
INDEED_API_KEY=

# Google Jobs (Optional - if enabled)
GOOGLE_API_KEY=

# Glassdoor (Optional - if enabled)
GLASSDOOR_PARTNER_ID=
GLASSDOOR_API_KEY=

# =============================================================================
# FEATURE FLAGS - Enable/Disable Platform Extensions
# =============================================================================

# Set to "true" to enable, "false" to disable
LINKEDIN_ENABLED=false
LINKEDIN_COUNTRY=US

INDEED_ENABLED=false
INDEED_COUNTRY=US

GLASSDOOR_ENABLED=false
GLASSDOOR_COUNTRY=US

GOOGLE_ENABLED=false
GOOGLE_COUNTRY=US

INFOJOBS_ENABLED=false
INFOJOBS_COUNTRY=ES

# =============================================================================
# PROXY CONFIGURATION (Optional)
# =============================================================================

# Static Proxy Configuration
STATIC_PROXY_ENABLED=false
STATIC_PROXY_HOST=
STATIC_PROXY_PORT=8080
STATIC_PROXY_USERNAME=
STATIC_PROXY_PASSWORD=

# Dynamic Proxy Configuration
DYNAMIC_PROXY_ENABLED=false
DYNAMIC_PROXY_SOURCE=

# =============================================================================
# BACKUP CONFIGURATION (Optional - for cloud backups)
# =============================================================================

# S3-compatible storage for backups (Backblaze B2 recommended - $0.005/GB)
S3_BUCKET=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=us-east-1
S3_ENDPOINT=s3.amazonaws.com

# =============================================================================
# RESILIENCE CONFIGURATION
# =============================================================================

# Circuit Breaker Settings
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
CIRCUIT_BREAKER_OPEN_TIMEOUT_SECONDS=60

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=10
RATE_LIMIT_CONCURRENT_SESSIONS=3

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================

# Enable/disable OpenTelemetry
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Log Level (Debug, Information, Warning, Error, Critical)
LOG_LEVEL=Information

# =============================================================================
# HOSTING PROVIDER CONFIGURATION
# Uncomment and configure for your provider
# =============================================================================

# Hetzner Cloud (Recommended for budget)
# HETZNER_API_TOKEN=
# HETZNER_SERVER_TYPE=cpx21
# HETZNER_LOCATION=nbg1

# DigitalOcean (Budget option)
# DO_API_TOKEN=
# DO_REGION=nyc3
# DO_SIZE=s-2vcpu-4gb

# Oracle Cloud (Free Tier)
# OCI_CONFIG_PATH=~/.oci/config
# OCI_PROFILE=DEFAULT

# AWS (If budget allows)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_INSTANCE_TYPE=t3.medium

# =============================================================================
# DOMAIN & SSL CONFIGURATION
# =============================================================================

# Domain name (leave empty for IP-based access)
DOMAIN=

# Email for Let's Encrypt SSL certificates
SSL_EMAIL=admin@example.com

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================

# Session Pool Configuration
SESSION_POOL_HOT_SIZE=3
SESSION_POOL_WARM_SIZE=5
SESSION_POOL_COLD_SIZE=10
SESSION_POOL_MAX_AGE_MINUTES=30

# Browser Configuration
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_SECONDS=30
BROWSER_VIEWPORT_WIDTH=1920
BROWSER_VIEWPORT_HEIGHT=1080

# Stealth Configuration
STEALTH_ENABLED=true
STEALTH_FINGERPRINT_ROTATION_INTERVAL=300
STEALTH_WEBRTC_DISABLED=true

# =============================================================================
# DEVELOPMENT OVERRIDES (Don't use in production)
# =============================================================================

# DEV_MODE=false
# DEBUG_LOGGING=false
# SKIP_HEALTH_CHECKS=false