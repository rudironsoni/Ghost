{
  "rabbit_version": "3.13.0",
  "rabbitmq_version": "3.13.0",
  "product_name": "RabbitMQ",
  "product_version": "3.13.0",
  "users": [
    {
      "name": "ghost",
      "password_hash": "YWRtaW4=",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": "administrator",
      "limits": {}
    },
    {
      "name": "monitoring",
      "password_hash": "bW9uaXRvcmluZw==",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": "monitoring",
      "limits": {}
    }
  ],
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "permissions": [
    {
      "user": "ghost",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    },
    {
      "user": "monitoring",
      "vhost": "/",
      "configure": "^$",
      "write": "^$",
      "read": ".*"
    }
  ],
  "topic_permissions": [],
  "parameters": [],
  "global_parameters": [
    {
      "name": "cluster_name",
      "value": "ghost@rabbitmq"
    }
  ],
  "policies": [
    {
      "vhost": "/",
      "name": "ha-all",
      "pattern": "^ghost\\.",
      "apply-to": "queues",
      "definition": {
        "ha-mode": "all",
        "ha-sync-mode": "automatic",
        "queue-type": "quorum"
      },
      "priority": 0
    }
  ],
  "queues": [
    {
      "name": "ghost.jobs.requests",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-delivery-limit": 5,
        "x-dead-letter-exchange": "ghost.dlx",
        "x-dead-letter-routing-key": "job.failed",
        "x-max-priority": 10
      }
    },
    {
      "name": "ghost.jobs.results",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "classic",
        "x-message-ttl": 604800000,
        "x-dead-letter-exchange": "ghost.dlx"
      }
    },
    {
      "name": "ghost.jobs.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "classic",
        "x-message-ttl": 2592000000
      }
    },
    {
      "name": "ghost.sessions.events",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-message-ttl": 86400000
      }
    },
    {
      "name": "ghost.sessions.commands",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    },
    {
      "name": "ghost.sessions.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "classic"
      }
    },
    {
      "name": "ghost.platform.linkedin",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-max-length": 10000,
        "x-overflow": "reject-publish"
      }
    },
    {
      "name": "ghost.platform.indeed",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-max-length": 10000,
        "x-overflow": "reject-publish"
      }
    },
    {
      "name": "ghost.platform.google",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-max-length": 10000,
        "x-overflow": "reject-publish"
      }
    },
    {
      "name": "ghost.platform.glassdoor",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-max-length": 10000,
        "x-overflow": "reject-publish"
      }
    },
    {
      "name": "ghost.platform.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "classic",
        "x-message-ttl": 604800000
      }
    },
    {
      "name": "ghost.metrics.raw",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "stream",
        "x-max-age": "7D",
        "x-stream-max-segment-size-bytes": 104857600
      }
    },
    {
      "name": "ghost.events.notifications",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    }
  ],
  "exchanges": [
    {
      "name": "ghost.jobs",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "ghost.sessions",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "ghost.platforms",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "ghost.metrics",
      "vhost": "/",
      "type": "fanout",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "ghost.events",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "ghost.dlx",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "ghost.jobs",
      "vhost": "/",
      "destination": "ghost.jobs.requests",
      "destination_type": "queue",
      "routing_key": "job.request.*",
      "arguments": {}
    },
    {
      "source": "ghost.jobs",
      "vhost": "/",
      "destination": "ghost.jobs.results",
      "destination_type": "queue",
      "routing_key": "job.result.*",
      "arguments": {}
    },
    {
      "source": "ghost.sessions",
      "vhost": "/",
      "destination": "ghost.sessions.events",
      "destination_type": "queue",
      "routing_key": "session.*",
      "arguments": {}
    },
    {
      "source": "ghost.sessions",
      "vhost": "/",
      "destination": "ghost.sessions.commands",
      "destination_type": "queue",
      "routing_key": "session.command.*",
      "arguments": {}
    },
    {
      "source": "ghost.platforms",
      "vhost": "/",
      "destination": "ghost.platform.linkedin",
      "destination_type": "queue",
      "routing_key": "linkedin",
      "arguments": {}
    },
    {
      "source": "ghost.platforms",
      "vhost": "/",
      "destination": "ghost.platform.indeed",
      "destination_type": "queue",
      "routing_key": "indeed",
      "arguments": {}
    },
    {
      "source": "ghost.platforms",
      "vhost": "/",
      "destination": "ghost.platform.google",
      "destination_type": "queue",
      "routing_key": "google",
      "arguments": {}
    },
    {
      "source": "ghost.platforms",
      "vhost": "/",
      "destination": "ghost.platform.glassdoor",
      "destination_type": "queue",
      "routing_key": "glassdoor",
      "arguments": {}
    },
    {
      "source": "ghost.metrics",
      "vhost": "/",
      "destination": "ghost.metrics.raw",
      "destination_type": "queue",
      "routing_key": "",
      "arguments": {}
    },
    {
      "source": "ghost.events",
      "vhost": "/",
      "destination": "ghost.events.notifications",
      "destination_type": "queue",
      "routing_key": "notification.*",
      "arguments": {}
    },
    {
      "source": "ghost.dlx",
      "vhost": "/",
      "destination": "ghost.jobs.dlq",
      "destination_type": "queue",
      "routing_key": "job.failed",
      "arguments": {}
    },
    {
      "source": "ghost.dlx",
      "vhost": "/",
      "destination": "ghost.sessions.dlq",
      "destination_type": "queue",
      "routing_key": "session.failed",
      "arguments": {}
    },
    {
      "source": "ghost.dlx",
      "vhost": "/",
      "destination": "ghost.platform.dlq",
      "destination_type": "queue",
      "routing_key": "platform.failed",
      "arguments": {}
    }
  ]
}