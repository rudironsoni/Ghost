# ============================================================================
# Ghost Platform Migration - Configuration File
# ============================================================================
#
# This configuration file allows you to set default values for migration
# scripts, avoiding the need to specify command-line arguments repeatedly.
#
# Usage:
#   ./migrate.sh --config migration.conf
#   ./export-data.sh --config migration.conf
#
# Note: Command-line arguments override values in this file
#
# ============================================================================

# =============================================================================
# SOURCE SYSTEM CONFIGURATION
# =============================================================================

# Source system hostname or IP address
# This is the system you're migrating FROM
SOURCE_HOST=prod.example.com

# SSH user for source system access
# Must have sudo privileges or Docker access
SOURCE_USER=admin

# =============================================================================
# TARGET SYSTEM CONFIGURATION
# =============================================================================

# Target system hostname or IP address
# This is the system you're migrating TO
# Use 'localhost' if running import on the target itself
TARGET_HOST=localhost

# =============================================================================
# MIGRATION OPTIONS
# =============================================================================

# Run in dry-run mode (simulate without making changes)
# Set to 'true' for testing, 'false' for actual migration
DRY_RUN=false

# Run in interactive mode (prompt for confirmations)
# Recommended for first-time migrations
INTERACTIVE=true

# Skip pre-migration validation checks
# Not recommended - only use if you know what you're doing
SKIP_VALIDATION=false

# Skip backup creation before import
# DANGEROUS - only use if you have external backups
SKIP_BACKUP=false

# =============================================================================
# DATA EXPORT/IMPORT OPTIONS
# =============================================================================

# Directory for exported data
# Defaults to ../backups/export_TIMESTAMP if not specified
# OUTPUT_DIR=/mnt/backup/ghost-export

# Compress exported data
# Reduces disk space and transfer time
COMPRESS=true

# Skip specific components during export/import
# Set to 'true' to skip, 'false' to include
SKIP_POSTGRES=false
SKIP_REDIS=false
SKIP_RABBITMQ=false

# =============================================================================
# VALIDATION OPTIONS
# =============================================================================

# Skip detailed data comparison during validation
# Speeds up validation but less thorough
SKIP_DATA_COMPARE=false

# =============================================================================
# PATHS AND DIRECTORIES
# =============================================================================

# Base directory for backups
# BACKUP_DIR=/mnt/backup/ghost

# Base directory for logs
# LOG_DIR=/var/log/ghost-migration

# =============================================================================
# SSH CONFIGURATION
# =============================================================================

# SSH connection timeout in seconds
# SSH_TIMEOUT=10

# SSH port (if non-standard)
# SSH_PORT=22

# SSH key path (if not using default)
# SSH_KEY_PATH=~/.ssh/id_rsa

# =============================================================================
# RESOURCE LIMITS
# =============================================================================

# Minimum required disk space in GB
# REQUIRED_DISK_SPACE_GB=20

# Maximum parallel export jobs
# PARALLEL_JOBS=4

# =============================================================================
# NOTIFICATION CONFIGURATION (Optional)
# =============================================================================

# Email for notifications (requires mail/sendmail configured)
# NOTIFICATION_EMAIL=admin@example.com

# Slack webhook URL for notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# =============================================================================
# ADVANCED OPTIONS
# =============================================================================

# PostgreSQL dump format (custom, plain, directory, tar)
# PG_DUMP_FORMAT=custom

# PostgreSQL dump compression level (0-9)
# PG_DUMP_COMPRESSION=9

# Redis save mode (bgsave or save)
# REDIS_SAVE_MODE=bgsave

# RabbitMQ export include messages
# RABBITMQ_INCLUDE_MESSAGES=true

# Retry failed operations
# RETRY_ON_FAILURE=true

# Maximum retry attempts
# MAX_RETRY_ATTEMPTS=3

# =============================================================================
# ENVIRONMENT OVERRIDES
# =============================================================================

# These override Docker Compose environment variables during migration

# Database password for target system
# DB_PASSWORD=new-secure-password

# RabbitMQ password for target system
# RABBITMQ_PASSWORD=new-rmq-password

# Grafana admin password for target system
# GRAFANA_PASSWORD=new-grafana-password

# =============================================================================
# EXAMPLES
# =============================================================================

# Example 1: Basic migration
# SOURCE_HOST=prod.example.com
# TARGET_HOST=localhost
# INTERACTIVE=true

# Example 2: Automated migration with custom paths
# SOURCE_HOST=10.0.1.50
# TARGET_HOST=localhost
# DRY_RUN=false
# INTERACTIVE=false
# OUTPUT_DIR=/mnt/backup/migration
# LOG_DIR=/var/log/migration

# Example 3: Export only (for later import)
# SOURCE_HOST=prod.example.com
# OUTPUT_DIR=/mnt/nas/ghost-export
# COMPRESS=true

# Example 4: Import only (from existing export)
# TARGET_HOST=localhost
# OUTPUT_DIR=/mnt/nas/ghost-export
# SKIP_VALIDATION=false

# =============================================================================
# NOTES
# =============================================================================

# 1. This file should be kept secure as it may contain sensitive information
# 2. Do not commit this file with real credentials to version control
# 3. Use .gitignore to exclude *.conf files
# 4. Command-line arguments always take precedence over config file values
# 5. Boolean values should be lowercase: true or false
# 6. Commented values show defaults or examples - uncomment to use

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
